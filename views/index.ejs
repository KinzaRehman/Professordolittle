<!--Index ejs, contains what the user will see on load -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Professor Do Little </title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Professor Do Little. </h1>
    <p> Rate your professors and share your experience,</p>
    


    <main>
        <!-- CREATE -->
        <form action="/reviews" method="POST">
            <h2>Add a Review</h2>
            <input name="university" placeholder="University">
            <input name="professor" placeholder="Professor">
            <textarea name="review" placeholder="Your review"></textarea>

            <select name="stars">
                <% for(let i = 1; i <= 5; i++) { %>
                    <option value="<%= i %>"><%= i %> Stars</option>
                <% } %>
            </select>

            <button type="submit">Submit Review</button>
        </form>

        <!-- rud, read the forum and allow user to update the ratings and stuff-->
        <section class="quotes-section">
            <h2>Professor Reviews</h2>
            <ul>
                <% reviews.forEach(review => { %>
                    <li>
                        <h3><%= review.professor %></h3>
                        <p><%= review.university %></p>
                        <p><%= review.review %></p>
                        <p>⭐ <%= review.stars %>/5</p>

                        <button class="update-button" data-id="<%= review._id %>">Edit</button>
<button class="delete-button" data-id="<%= review._id %>" aria-label="Delete review">×</button>                    </li>
                <% }) %>
            </ul>
        </section>
    </main>

    <script src="/main.js"></script>
</body>
</html>